# ---- ShadowWatch config: copy to .env and fill in ----
# 4-digit code for the website
DASHBOARD_PIN=4821

# Discord: Server settings -> Integrations -> Webhooks -> New webhook -> Copy URL
DISCORD_WEBHOOK_URL=
# Optional: who to ping on urgent alerts (setup / exit). Your user id: <@123456789012345678>, or @here
DISCORD_PING=

# Optional, recommended as a 2nd channel: free phone push via the ntfy app (pick an unguessable topic name)
NTFY_TOPIC=
# Optional: Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Solana RPC(s), comma separated. Public ones work, a free Helius key is faster:
# RPC_URLS=https://mainnet.helius-rpc.com/?api-key=YOURKEY,https://api.mainnet-beta.solana.com
RPC_URLS=https://api.mainnet-beta.solana.com,https://solana-rpc.publicnode.com
POLL_SECONDS=2.5

# Only shadows with at least this conviction score send pings (others still show on the website)
MIN_SHADOW_SCORE_ALERT=40
ALERT_CUPSEY_BUYS=1
ALERT_CUPSEY_SELLS=1
# A shadow buy followed by a Cupsey buy within this many seconds = "setup"
SETUP_WINDOW_SECONDS=600

PORT=8751
# Start a free Cloudflare quick tunnel and post the link to Discord (1) or not (0)
TUNNEL=1

# Only needed to re-run the wallet discovery on the Pi (python3 research/discover.sh): https://www.solanatracker.io/data-api
SOLANATRACKER_API_KEY=
